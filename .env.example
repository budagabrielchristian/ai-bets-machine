# Copy to .env and fill in. Never commit .env.

# Your domain (Docker + Caddy setup only), e.g. bets.example.com
DOMAIN=

# Optional: The Odds API key (https://the-odds-api.com). Adds many bookmakers,
# including Pinnacle, which the Value hunter AI needs. Server-side only.
ODDS_API_KEY=
ODDS_API_SPORTS=soccer_epl
# Minutes between Odds API calls. Free plan = 500 calls/month; 120 fits one league.
ODDS_API_INTERVAL_MINUTES=120

# Cloudflare Tunnel on your own PC: set TRUST_PROXY=cloudflare and HOST=127.0.0.1
# TRUST_PROXY=
# HOST=
# PORT=8787
